{
  "name": "@sencrop/capacitor-intercom",
  "version": "10.0.1",
  "description": "Intercom Plugin for Capacitor",
  "main": "dist/plugin.cjs.js",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "unpkg": "dist/plugin.js",
  "files": [
    "android/src/main/",
    "android/build.gradle",
    "dist/",
    "ios/Plugin/",
    "SencropCapacitorIntercom.podspec"
  ],
  "author": "Sencrop",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sencrop/capacitor-intercom.git"
  },
  "bugs": {
    "url": "https://github.com/sencrop/capacitor-intercom/issues"
  },
  "keywords": [
    "capacitor",
    "plugin",
    "native"
  ],
  "scripts": {
    "verify": "pnpm run verify:ios && pnpm run verify:android && pnpm run verify:web",
    "verify:ios": "cd ios && pod install && xcodebuild clean build test -workspace Plugin.xcworkspace -scheme Plugin -destination \"platform=iOS Simulator,name=iPhone 14\" && cd ..",
    "verify:android": "cd android && ./gradlew clean build test && cd ..",
    "verify:web": "pnpm run build",
    "docgen": "docgen --project tsconfig.docgen.json --api IntercomPlugin --output-readme README.md --output-json dist/docs.json && vp fmt README.md",
    "build": "pnpm run clean && pnpm run docgen && tsc && rollup -c rollup.config.mjs",
    "clean": "rimraf ./dist",
    "watch": "tsc --watch",
    "prepublishOnly": "pnpm run build",
    "prepare": "vp config",
    "check": "vp check"
  },
  "devDependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/docgen": "^0.3.1",
    "@capacitor/ios": "^8.0.0",
    "rimraf": "^6.1.0",
    "rollup": "^4.53.2",
    "typescript": "^5.9.3",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@capacitor/core": ">=8.0.0"
  },
  "engines": {
    "node": ">=18.15.0"
  },
  "capacitor": {
    "ios": {
      "src": "ios"
    },
    "android": {
      "src": "android"
    }
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.21.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.11.2",
      "onFail": "download"
    }
  }
}
